{
  "name": "@fc27/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure game logic: chemistry, squad rating, chemistry styles and true rating.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
