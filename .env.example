# Copy to `.env.local` for local development. Never commit real values.
# In CI these come from GitHub repository secrets; at runtime from the
# hosting platform's encrypted environment variables. See CONTRIBUTING.md.

# Optional overrides for the build information shown in the app footer.
# On Vercel these are derived from VERCEL_GIT_COMMIT_SHA and VERCEL_ENV.
APP_COMMIT_SHA=
APP_ENV=development
