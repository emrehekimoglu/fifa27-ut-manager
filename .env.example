# Copy to `.env.local` for local development. Never commit real values.
# In CI these come from GitHub repository secrets; at runtime from the
# hosting platform's encrypted environment variables. See CONTRIBUTING.md.

# Optional overrides for the build information shown in the app footer.
# On Vercel these are derived from VERCEL_GIT_COMMIT_SHA and VERCEL_ENV.
APP_COMMIT_SHA=
APP_ENV=development

# Browser access to Supabase (Vercel: Production and Preview). The publishable key is
# safe to expose; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side access for the catalog sync (GitHub secrets). Never expose these.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
